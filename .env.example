# Configuração pública do frontend: Vite incorpora VITE_* ao bundle.
# Nunca adicionar tokens, senhas ou segredos server-side, nem em URLs.

# development | homologation | production
# Vazio: development apenas no contexto DEV do Vite; production nos demais.
# Para homologação, definir homologation explicitamente antes de iniciar/buildar.
VITE_APP_ENV=

# URL pública HTTP(S) de uma futura API. Opcional; nenhuma integração ativa.
VITE_PUBLIC_API_URL=
